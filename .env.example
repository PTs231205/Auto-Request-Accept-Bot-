# ===========================================
# TELEGRAM BOT CONFIGURATION
# ===========================================

# Bot Token (Get from @BotFather)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Admin User ID (Your Telegram User ID)
ADMIN_ID=YOUR_ADMIN_ID_HERE

# Bot Username (Without @)
BOT_USERNAME=YOUR_BOT_USERNAME

# ===========================================
# DATABASE CONFIGURATION
# ===========================================

# PostgreSQL Database URL
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://username:password@localhost:5432/telegram_bot

# Alternative format for cloud databases
# DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require

# ===========================================
# CHANNEL & SUPPORT CONFIGURATION
# ===========================================

# Main Channel Link
MAIN_CHANNEL_LINK=https://t.me/YOUR_CHANNEL

# Support Chat Link
SUPPORT_CHAT=https://t.me/YOUR_SUPPORT_CHAT

# ===========================================
# BROADCASTING SETTINGS
# ===========================================

# Delay between broadcast messages (seconds)
BROADCAST_DELAY=0.1

# Maximum retry attempts for failed messages
MAX_RETRIES=3

# Delay between retry attempts (seconds)
RETRY_DELAY=2

# ===========================================
# BOT FEATURES
# ===========================================

# Enable detailed logging
ENABLE_LOGS=true

# Enable statistics tracking
ENABLE_STATS=true

# Enable user information collection
ENABLE_USER_INFO=true

# ===========================================
# UI CUSTOMIZATION
# ===========================================

# Admin Panel Title
ADMIN_PANEL_TITLE=🔧 Admin Panel

# Welcome Image URL (Optional)
WELCOME_IMAGE=

# ===========================================
# DEVELOPMENT SETTINGS
# ===========================================

# Set to 'development' for testing, 'production' for live
ENVIRONMENT=production

# Debug mode (true/false)
DEBUG=false